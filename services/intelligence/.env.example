# Copy to .env and fill in. Never commit real values.
# --- Service auth (shared with the Next.js app: INTELLIGENCE_URL + the same secret) ---
INTELLIGENCE_SERVICE_TOKEN=
INTELLIGENCE_SIGNING_SECRET=
# Optional: previous secret still accepted during rotation
INTELLIGENCE_SIGNING_SECRET_PREVIOUS=
# --- Database (role limited to the `intel` schema). Unset => in-memory store (dev/tests only) ---
INTEL_DATABASE_URL=
# --- LLM (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional cheaper model for the entailment check
OPENAI_MODEL_ENTAILMENT=
# --- Search / news (D-03: Tavily + GDELT fallback) ---
# SEARCH_PROVIDER=tavily|brave|none. Tavily's free plan is 1,000 credits/month, no card (1 credit per basic search);
# one key serves both web search and news. Brave no longer has a free plan for new accounts.
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=
# NEWS_FALLBACK=gdelt adds GDELT's free keyless news API: used when the provider's news fails (quota/outage), or on its
# own when SEARCH_PROVIDER=none. BEST-EFFORT ONLY: slow (~15 s/query) and heavily rate-limited. Off unless you opt in.
NEWS_FALLBACK=none
GDELT_LANGUAGE=english
# --- Fetching ---
FETCH_USER_AGENT=LeadGennieBot/1.0 (+https://leadgennie.com/bot)
FETCH_MAX_BYTES=2000000
FETCH_HOST_RPS=1.0
# --- Behavior ---
VERIFY_THRESHOLD=0.70
MAX_CONCURRENT_RUNS=4
LOG_LEVEL=INFO
# Deterministic canned results, no network/LLM (for developing the Next.js side)
ENGINE_FAKE_MODE=0
