{
  "name": "leadgennie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fake-metrics": "node scripts/checks/no-fake-metrics.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:fake-metrics && npm run check:tenancy && npm run test && npm run build",
    "verify:engine": "make -C services/intelligence verify",
    "verify:all": "npm run verify && npm run verify:engine",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:migrate:status": "node --env-file=.env.local scripts/migrate.mjs --status",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "scheduler": "node --env-file=.env.local scripts/scheduler.mjs",
    "check:tenancy": "node scripts/checks/workspace-scoped-sql.mjs",
    "eval:personalization": "RUN_LIVE_LLM=1 node --env-file=.env.local node_modules/.bin/vitest run tests/live/personalization-eval.live.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "node-cron": "^4.6.0",
    "openai": "^7.23.0",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.1",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
