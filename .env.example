# Copy to .env.local and fill in. Every variable below is read by code in this
# repo (grep process.env). Never commit real values.

# --- Required -----------------------------------------------------------------
# Neon Postgres connection string (pooled). Migrate with `npm run db:migrate`.
DATABASE_URL=
# NextAuth v5 secret: `openssl rand -base64 32`
AUTH_SECRET=
# AES-256-GCM key for stored connector credentials: `openssl rand -base64 32`
# (must decode to exactly 32 bytes). Losing it makes stored HubSpot tokens AND connected Gmail/Microsoft mailboxes unreadable
# (every mailbox would need to be reconnected).
CREDENTIALS_ENCRYPTION_KEY=
# Shared secret for /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- AI (OpenAI) --------------------------------------------------------------
# All LLM calls go through lib/ai/client.ts (OpenAI adapter). Default model gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# From address for invite/welcome emails. Must be on a domain verified in Resend,
# e.g. "LeadGennie <hello@yourdomain.com>".
RESEND_FROM_EMAIL=
# Svix signing secret for POST /api/webhooks/resend (bounce/complaint)
RESEND_WEBHOOK_SECRET=

# --- Mailbox OAuth (Settings → Mailboxes) -------------------------------------
# "Connect Google" / "Connect Microsoft": users sign in and LeadGennie sends through their own mailbox.
# A provider whose id/secret are empty shows "Not set up on this server" — nothing breaks. Setup: docs/mailboxes.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Default: <public app URL>/api/mailboxes/google/callback — must match the Google Cloud console EXACTLY.
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Default: <public app URL>/api/mailboxes/microsoft/callback — must match the Entra app registration EXACTLY.
MICROSOFT_REDIRECT_URI=
# Optional. "common" (default) = work/school AND personal accounts; set a tenant id to allow one organisation only.
MICROSOFT_TENANT=

# --- HubSpot OAuth (optional; Settings → Integrations) -----------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Optional override of requested scopes (space/comma separated)
HUBSPOT_SCOPES=

# --- URLs ---------------------------------------------------------------------
# Public base URL used to build unsubscribe links in emails AND the mailbox OAuth callback addresses.
# Falls back to https://$VERCEL_URL, then http://localhost:3000.
# Public origin used in emailed links (invites, welcome, unsubscribe). Production: https://leadgennie.com
NEXT_PUBLIC_APP_URL=
# Base URL the always-on scheduler calls (scripts/scheduler.mjs)
APP_URL=http://localhost:3000
# node-cron expression for scripts/scheduler.mjs
SCHEDULER_CRON=*/10 * * * *

# --- Feature flags ------------------------------------------------------------
# Show non-V1 modules (Deals, Tasks, Agentic Flows, CRM Sync, …) in the nav.
NEXT_PUBLIC_SHOW_LEGACY_MODULES=
# D-05: "true" offers the multi-channel (LinkedIn DM) campaign wizard next to the email-only builder. Default off.
FEATURE_LINKEDIN_AUTOMATION=
# Extra browser-extension IDs allowed to use the connect flow (comma-separated), e.g. a Chrome Web Store build's ID.
# The unpacked/dev extension's ID is pinned in chrome-extension/manifest.json and is always allowed.
EXTENSION_ALLOWED_IDS=

# --- Seeding (scripts/seed.mjs only) -----------------------------------------
# Password for the demo user. If unset, a random one is generated and printed once.
SEED_DEMO_PASSWORD=

# --- Intelligence Engine (Python service, services/intelligence/) — docs/intelligence-engine/ -------
# Private service the job worker calls for research. Same values as the engine's own .env.
INTELLIGENCE_URL=http://localhost:8000
INTELLIGENCE_SERVICE_TOKEN=
# HMAC secret used to sign requests (timestamp.METHOD.path.body); rotate by also setting the engine's *_PREVIOUS.
INTELLIGENCE_SIGNING_SECRET=
