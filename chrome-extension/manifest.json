{
  "manifest_version": 3,
  "name": "LeadGennie",
  "version": "5.0.0",
  "description": "Capture prospects from any page into LeadGennie and start research — connected to your own workspace, in two clicks.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "optional_permissions": [
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://leadgennie.com/*",
    "*://*.linkedin.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content/widget-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/widget.mjs",
        "ui/dom.js",
        "ui/icons.js",
        "ui/capture-card.js",
        "ui/lead-summary.js",
        "lib/capture-model.js",
        "lib/messages.js",
        "lib/config.js",
        "lib/page-facts.js",
        "ui/lg.css",
        "fonts/Geist-Variable.woff2"
      ],
      "matches": [
        "*://*.linkedin.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "LeadGennie",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
